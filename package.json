{
  "name": "agent-skills",
  "private": true,
  "type": "module",
  "scripts": {
    "lint-staged": "lint-staged --concurrent false --no-stash --no-hide-partially-staged",
    "prepare": "husky",
    "pre-commit": "just pre-commit"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "^3.9.6"
  },
  "lint-staged": {
    "*": "bash -c 'just evm-atlas-check' --",
    "{skills/*/scripts/*.sh,tests/**/*.sh,tests/**/*.bats}": "shellcheck",
    "**/*.md": "bunx --no-install prettier --write --cache --log-level warn",
    "skills/*/{SKILL.md,agents/openai.yaml}": "bash -c 'just skill-invocation-check' --",
    "scripts/sync-invocation-policy.mjs": "bash -c 'just skill-invocation-check' --"
  }
}
